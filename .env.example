# 复制为 .env 后填写；.env 不进仓库
# 模型：DeepSeek（OpenAI 兼容接口）
# 占位符而已：真 key 只写进 .env（不进仓库、不进提交包），别贴到这里
LLM_API_KEY=sk-your-own-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 离线演示开关：1 = 不联网，用预置回复（演示翻车时一键切换）
MOCK_LLM=0

# 会话与数据
DATA_DIR=data/memory
LOG_DIR=data/logs

# 网络检索（P8b）：中文/ACG 走博查，英文/技术走 Tavily；一次只查一家
# 默认关闭：先填 key 再改 ALLOW_WEB=1（没 key 会多绕一次 401）
ALLOW_WEB=0
WEB_PROVIDER=auto
BOCHA_API_KEY=
BOCHA_ENDPOINT=https://api.bocha.cn/v1/web-search
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search
# 旧单 provider 配置仍兼容：WEB_API_KEY 只在专用 key 缺失时兜底
