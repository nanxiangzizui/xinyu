# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行时数据（重要：绝不提交真实对话）----
data/memory/*.json
data/memory/*.bak
data/memory/*.tmp
data/memory_backup/*.json
data/logs/*.jsonl
!.gitkeep

# ---- 证据与产物 ----
# 只忽略根目录的临时证据夹；docs/evidence/ 是正式证据，必须入库
/evidence/
screenshots/
*.mp4
# 例外：演示视频是比赛材料（2.1MB，需随仓库走），其余录屏原片不入库
!docs/03_演示视频.mp4
*.webm
*.zip
dist/
*.log
*.tmp

# ---- 编辑器与系统 ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
.claude/settings.local.json
