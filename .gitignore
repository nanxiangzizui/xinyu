# ---- 密钥与本地配置 ----
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行时数据（重要：绝不提交真实对话）----
data/memory/*.json
data/memory/*.bak
data/memory/*.tmp
data/memory_backup/*.json
data/logs/*.jsonl
# 最近一张角色卡（「继承上一张」用）：本地便利数据，不进仓库
# DATA_DIR 默认 data/memory，所以实际落盘在 data/memory/rolecards/
data/rolecards/*.json
data/rolecards/*.tmp
data/memory/rolecards/*.json
data/memory/rolecards/*.tmp
# A 情景记忆（P10）：与 memory.json 分开存，清空时一起删
data/memory/episodes/*.json
data/memory/episodes/*.bak
data/memory/episodes/*.tmp
# 趣味测试结果（P13）：落在 data/memory/quiz/ 子目录，上面那条 *.json 匹配不到子目录
data/memory/quiz/*.json
data/memory/quiz/*.bak
data/memory/quiz/*.tmp
# 兜底（P20 开源前自查）：data/ 下任何文件一律不进仓库，将来加子目录不会再漏
data/**
!.gitkeep

# 脚本 mkdtemp(prefix="p19_") / "p16-" 之后留在根目录的临时会话目录
# 必须锚定根目录：不锚定会在 Windows（core.ignorecase）下把 docs/evidence/P47-* 这类证据目录也吃掉
/p[0-9][0-9][-_]*/

# ---- 本地人工测试记录（含真人对话，绝不进仓库）----
真人测试/
测试*.txt
/in
pytest-of-*/

# ---- 证据与产物 ----
# 只忽略根目录的临时证据夹；docs/evidence/ 是正式证据，必须入库
/evidence/
screenshots/
*.mp4
# 例外：演示视频是比赛材料（2.1MB，需随仓库走），其余录屏原片不入库
!docs/03_演示视频.mp4
*.webm
*.zip
dist/
*.log
*.tmp

# ---- 编辑器与系统 ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
.claude/settings.local.json

# Word 打开文档时生成的锁文件（~$xxx.docx）
~$*

# 截图脚本用的无头浏览器临时配置（docs/evidence 下，体积大、不入库）
_edge*/
