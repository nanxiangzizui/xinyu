# Streamlit Cloud / 本地模拟用的 Secrets 模板（不含真实密钥，可入库）
# 用法：复制为 .streamlit/secrets.toml 再填值；该文件已被 .gitignore 排除，绝不提交。
# 线上部署请在 Streamlit Cloud 后台 → App settings → Secrets 粘贴同样内容。
# 本地开发优先用 .env；两者同时存在时以先读到的为准（app.py 的 _bridge_secrets 只补空缺）。
# 注意：本地放 secrets.toml 会让 tests/test_fault.py::test_f06 变红（该用例模拟“没有 Key”），
#      跑全量测试前请先移走本文件对应的 secrets.toml。

LLM_API_KEY = "<在 https://platform.deepseek.com 申请，sk- 开头>"
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"
MOCK_LLM = "0"
DATA_DIR = "data/memory"
LOG_DIR = "data/logs"

# P8b 网络工具：中文/ACG 走博查，英文/技术走 Tavily；一次只查一家
# 先填 key 再开 ALLOW_WEB=1；没 key 时模型会看到工具、调一次、拿 401，多绕一圈。
ALLOW_WEB = "0"
WEB_PROVIDER = "auto"
BOCHA_API_KEY = "<博查控制台申请>"
BOCHA_ENDPOINT = "https://api.bocha.cn/v1/web-search"
TAVILY_API_KEY = "<Tavily 控制台申请>"
TAVILY_ENDPOINT = "https://api.tavily.com/search"
# 旧单 provider 配置仍兼容：WEB_API_KEY 只在专用 key 缺失时兜底
